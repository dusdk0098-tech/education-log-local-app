{
  "name": "pedit-edu",
  "version": "1.0.4",
  "description": "PEDIT EDU 안전보건교육일지 Electron 호스트",
  "author": "PEDIT",
  "private": true,
  "main": "electron/main.cjs",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test:python": "py -3 -m unittest tests.test_launcher_host tests.test_launcher_server",
    "test:electron": "node --test tests/electron/*.test.cjs",
    "test": "npm run test:python && npm run test:electron",
    "build:backend": "py -3 -m PyInstaller --noconfirm --clean --distpath dist-backend --workpath build/PeditEduBackend PeditEduBackend.spec && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign-backend.ps1",
    "package:launcher-dir": "npm run build:backend && electron-builder --dir --win --x64 --config.directories.output=release",
    "package:launcher-release": "npm run package:launcher-dir && node scripts/build-launcher-release.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dusdk0098-tech/education-log-local-app.git"
  },
  "license": "ISC",
  "dependencies": {
    "@pedit/electron-app-sdk": "file:packages/electron-app-sdk"
  },
  "devDependencies": {
    "electron": "42.6.1",
    "electron-builder": "26.15.3",
    "playwright": "1.61.1"
  },
  "build": {
    "appId": "kr.pedit.edu",
    "productName": "PEDIT EDU",
    "executableName": "PeditEdu",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "electron/**",
      "static/app.ico"
    ],
    "extraResources": [
      {
        "from": "dist-backend/PeditEduBackend.exe",
        "to": "backend/PeditEduBackend.exe"
      },
      {
        "from": "launcher-required.json",
        "to": "launcher-required.json"
      }
    ],
    "win": {
      "icon": "static/app.ico",
      "executableName": "PeditEdu",
      "signtoolOptions": {
        "certificateSha1": "B92BEC0B6370F10BC34CB27304921DE75B3073C6"
      },
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ]
    }
  }
}
